# Copy to .env. Expo inlines EXPO_PUBLIC_* variables at build time, so
# restart `expo start` after changing them.
#
# The API base, including /api/v1. On a physical device this must be the
# machine's LAN address (for example http://192.168.1.20/...), never
# localhost. The Android emulator reaches the host at 10.0.2.2; the iOS
# simulator can use localhost.
EXPO_PUBLIC_API_URL=http://10.0.2.2/Aswin/dating_app/public/api/v1
